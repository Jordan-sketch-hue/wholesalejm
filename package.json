{
  "name": "jamaican-wholesale-ecommerce",
  "version": "1.0.0",
  "description": "Premium Jamaican wholesale e-commerce platform",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec node server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "jamaica",
    "wholesale",
    "ecommerce",
    "commerce"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^7.5.0",
    "redis": "^4.6.8",
    "stripe": "^13.7.0",
    "socket.io": "^4.7.1",
    "axios": "^1.5.0",
    "cloudinary": "^1.35.0",
    "multer": "^1.4.5-lts.1",
    "joi": "^17.10.2",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "express-mongo-sanitize": "^2.2.0",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "tailwindcss": "^3.3.5",
    "postcss": "^8.4.30",
    "autoprefixer": "^10.4.15",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3"
  }
}
